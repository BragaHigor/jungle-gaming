# Local development only. Use / (or leave empty) on Vercel for the same origin.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
NEXT_PUBLIC_REALTIME_PATH=/api/realtime/socket.io
REALTIME_PORT=3001
# Local development. On Vercel, deployment/branch hosts are detected automatically.
# Add exact HTTPS origins here for additional custom domains; never use a wildcard.
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=
# Configure independent databases for Vercel Preview (HML) and Production (PRD).
# Optional direct PostgreSQL URL for LISTEN (Neon direct URL is derived automatically).
REALTIME_DATABASE_URL=
TEST_DATABASE_URL=
